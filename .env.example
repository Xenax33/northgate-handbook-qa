# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# HANDBOOK_TODAY=2026-11-22      (pretend it is this date; the eval sets this itself)
# UPLOAD_TOKEN=choose-a-long-random-value   (set on any public server: uploads then need it)
